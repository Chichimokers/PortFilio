          description: 'Plataforma para cambiar Pesos Mexicanos a USDT y Peso Cubano (CUP) al instante. Transferencias rapidas y seguras.',
          link: null,
          linkLabel: null,
          tech: ['Fintech', 'Crypto', 'Exchange'],
          image: '/images/remesas-mx.png',
          icon: 'fa-solid fa-money-bill-transfer',
