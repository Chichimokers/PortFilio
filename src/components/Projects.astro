          image: null,
          icon: 'fa-solid fa-brain',
          private: false,
        },
      ].map(project => (
        <div class="neon-card" style="display: flex; flex-direction: column;">
          {project.image ? (
            <img src={project.image} alt={project.title} class="project-image" style="margin-bottom: 1rem;" />
          ) : (
            <div style="height: 120px; border-radius: 10px; background: linear-gradient(135deg, rgba(0, 240, 255, 0.05), rgba(255, 0, 170, 0.05)); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
              <i class={project.icon} style="font-size: 2.5rem; background: linear-gradient(135deg, var(--cyan), var(--magenta)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; opacity: 0.6;"></i>
            </div>
          )}

          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <h3 style="font-family: 'Orbitron', sans-serif; font-weight: 600; font-size: 1rem; color: var(--text-bright); letter-spacing: 1px;">{project.title}</h3>
            {project.private && (
              <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; padding: 2px 8px; border-radius: 4px; background: rgba(255, 0, 170, 0.1); color: var(--magenta); border: 1px solid rgba(255, 0, 170, 0.2);">PRIVATE</span>
            )}
          </div>

          <p style="font-size: 0.9rem; color: var(--text); line-height: 1.7; margin-bottom: 1rem; flex-grow: 1;">{project.description}</p>

          <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1rem;">
            {project.tech.map(t => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>

          {project.link && (
            <a href={project.link} target="_blank" rel="noopener noreferrer" class="cta-btn" style="font-size: 0.65rem; padding: 10px 20px; align-self: flex-start;">
              <i class="fa-solid fa-arrow-up-right-from-square"></i> {project.linkLabel || 'VISITAR'}
            </a>
          )}
        </div>
      ))
