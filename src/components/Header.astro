<header style="display: flex; justify-content: space-between; align-items: center; padding: 2rem 0; position: relative; z-index: 10;">
  <a href="/" style="text-decoration: none;">
    <span style="font-family: 'Orbitron', sans-serif; font-weight: 800; font-size: 1.5rem; background: linear-gradient(135deg, #00f0ff, #ff00aa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; letter-spacing: 2px;" class="glitch-hover">ERC</span>
  </a>
  <nav style="display: flex; align-items: center; gap: 2rem;">
    <ul style="display: flex; gap: 2rem; list-style: none;">
      <li><a href="#about" style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--text); text-decoration: none; letter-spacing: 1px; transition: color 0.3s;" onmouseover="this.style.color='#00f0ff'" onmouseout="this.style.color='var(--text)'" data-i18n="nav_about">_sobre_mi</a></li>
      <li><a href="#skills" style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--text); text-decoration: none; letter-spacing: 1px; transition: color 0.3s;" onmouseover="this.style.color='#00f0ff'" onmouseout="this.style.color='var(--text)'" data-i18n="nav_skills">_habilidades</a></li>
      <li><a href="#projects" style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--text); text-decoration: none; letter-spacing: 1px; transition: color 0.3s;" onmouseover="this.style.color='#00f0ff'" onmouseout="this.style.color='var(--text)'" data-i18n="nav_projects">_proyectos</a></li>
      <li><a href="#contact" style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--text); text-decoration: none; letter-spacing: 1px; transition: color 0.3s;" onmouseover="this.style.color='#ff00aa'" onmouseout="this.style.color='var(--text)'" data-i18n="nav_contact">_contacto</a></li>
    </ul>
    <button id="lang-toggle" style="font-family: 'Orbitron', sans-serif; font-size: 0.7rem; font-weight: 700; letter-spacing: 2px; padding: 6px 14px; border: 1px solid var(--magenta); color: var(--magenta); background: transparent; border-radius: 6px; cursor: pointer; transition: all 0.3s ease;">EN</button>
  </nav>
</header>
